<Page x:Class="ComponentVault.WinUI.Views.KittingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="24" Spacing="16">
  <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="配套件" />
  <TextBlock Text="从库存选料或载入 BOM 预设，复核数量与库位后一次确认出库。" TextWrapping="Wrap" />
  <StackPanel Orientation="Horizontal" Spacing="12">
   <ComboBox x:Name="PresetBox" Header="BOM 预设" MinWidth="240" />
   <Button Content="带入预设" Click="OnLoadPreset" VerticalAlignment="Bottom" />
   <Button Content="新建配套件" Click="OnNewKit" VerticalAlignment="Bottom" />
  </StackPanel>
  <TextBox x:Name="ProjectBox" Header="配套件名称" Text="配套件" TextChanged="OnProjectChanged" />
  <NumberBox x:Name="BatchBox" Header="套数" Value="1" Minimum="1" SpinButtonPlacementMode="Inline" ValueChanged="OnBatchChanged" />
  <StackPanel Orientation="Horizontal" Spacing="12">
   <AutoSuggestBox x:Name="InventorySearch" Header="从库存添加" PlaceholderText="SKU、型号、封装或名称" MinWidth="320" TextChanged="OnSearchChanged" SuggestionChosen="OnSuggestionChosen" />
   <NumberBox x:Name="AddQuantity" Header="每套用量" Value="1" Minimum="1" SpinButtonPlacementMode="Inline" Width="150" />
   <Button Content="添加选料" Click="OnAdd" VerticalAlignment="Bottom" />
  </StackPanel>
  <TextBlock x:Name="StatusText" Text="尚未选料。添加库存项，或带入 BOM 预设。" TextWrapping="Wrap" />
  <StackPanel x:Name="RowsPanel" Spacing="12" />
  <TextBlock Text="扣料库位计划" FontSize="18" FontWeight="SemiBold" />
  <TextBlock x:Name="PlanText" Text="尚无可出库项目。" TextWrapping="Wrap" />
  <Button x:Name="ConfirmButton" Content="复核并确认出库" Click="OnConfirm" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
 </StackPanel></ScrollViewer>
</Page>
